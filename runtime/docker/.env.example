#   cp .env.example .env

# URL canónica de la instancia (obligatoria en v2; el server rechaza arrancar sin ella).
AUTHORIZER_URL=http://localhost:8080

# OAuth client (obligatorio en v2). Es el client-id de la app que consume Authorizer.
AUTHORIZER_CLIENT_ID=latiendita
AUTHORIZER_CLIENT_SECRET=

# Secret del dashboard admin (obligatorio, no puede quedar vacío).
AUTHORIZER_ADMIN_SECRET=

# Firma JWT HS256 (obligatorio con --jwt-type=HS256).
AUTHORIZER_JWT_SECRET=

# Cifrado en reposo de TOTP/OTP. Usá un valor distinto de JWT_SECRET:
# si son iguales, rotar el JWT secret bloquea a todo usuario con MFA enrolado.
AUTHORIZER_ENCRYPTION_KEY=