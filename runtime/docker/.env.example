# Copiar a .env antes de levantar el stack. NUNCA versionar el .env resultante.
# cp runtime/docker/.env.example runtime/docker/.env

# --- PostgreSQL (un cluster, una base por microservicio) ---
POSTGRES_USER=tienda
POSTGRES_PASSWORD=

# --- Authorizer: usuarios, roles y permisos ---
# URL canónica de la instancia (obligatoria en v2).
AUTHORIZER_URL=http://localhost:8080
AUTHORIZER_CLIENT_ID=latiendita
AUTHORIZER_CLIENT_SECRET=
AUTHORIZER_ADMIN_SECRET=
# HS256: el gateway usa este mismo valor como JWT_SECRET.
AUTHORIZER_JWT_SECRET=
# Distinto de JWT_SECRET: rotar el JWT no debe romper el MFA enrolado.
AUTHORIZER_ENCRYPTION_KEY=
# Orígenes permitidos. Agregar aquí la URL pública de ngrok del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Object storage (Azurite, clave pública de desarrollo) ---
AZURE_STORAGE_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# --- Webhooks de Mercado Pago ---
# La notification URL debe ser la URL pública del gateway terminada en
# /api/webhooks/mercado-pago (usar el túnel ngrok cuando corresponda).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# --- ngrok: publica el frontend externo (:3000) y el gateway (:8081) ---
# Sin token el contenedor queda inactivo y el resto del stack funciona igual.
NGROK_AUTHTOKEN=
# Opcional: dominios reservados. Vacío = ngrok asigna una URL aleatoria.
NGROK_FRONTEND_DOMAIN=
NGROK_GATEWAY_DOMAIN=
